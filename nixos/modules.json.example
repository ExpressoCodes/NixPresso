{
  "uxplay": {
    "type": "flake-module",
    "input": "uxplay",
    "url": "github:ExpressoCodes/uxplay",
    "source": "system",
    "enabled": true
  },
  "localsend": {
    "type": "program-option",
    "option": "programs.localsend.enable",
    "extras": { "openFirewall": true },
    "source": "system",
    "enabled": true
  },
  "nixstore": {
    "type": "flake-module",
    "input": "nixstore",
    "url": "github:ExpressoCodes/nixstore",
    "source": "system",
    "enabled": true
  }
}
