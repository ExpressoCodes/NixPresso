# NixOS — machine-specific, generate with: sudo nixos-generate-config
nixos/hardware-configuration.nix

# Let nixos-rebuild generate a fresh lock on first build
nixos/flake.lock

#Hyprland backup files
home/.config/hypr/*.bak
home/.config/hypr/*.pre-*

# Rofi backup files
home/.config/rofi/*.bak

# NixStore — machine-local managed files (committed examples are tracked separately)
nixos/modules.json

# OS / editor noise
.DS_Store
*.swp
*~
